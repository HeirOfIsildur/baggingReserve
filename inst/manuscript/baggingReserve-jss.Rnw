fmt <- function(x, digits = 0) format(round(x, digits), big.mark = ",", nsmall = digits, trim = TRUE)
bfmt <- function(b) if (b >= 1e4) formatC(b, format = "d", big.mark = "{,}") else as.character(b)   # house style: 1000, 10{,}000
pct <- function(x, digits = 1) paste0(formatC(100 * x, format = "f", digits = digits), "\\%")
pct_small <- function(x, digits = 2) if (abs(100 * x) < 0.5 * 10^(-digits)) paste0("less than ", formatC(10^(-digits), format = "f", digits = digits), "\\%") else pct(abs(x), digits)
signed <- function(e, digits = 1) if (e < 0) paste("underpredicted by", pct(-e, digits)) else paste("overpredicted by", pct(e, digits))
sentence <- function(x) paste0(toupper(substring(x, 1, 1)), substring(x, 2))   # sentence-style table labels
net_of <- function(a, b) if (sign(a) != sign(b)) ", so the component errors partly offset each other" else ", so the component errors add up"
missing_txt <- function(what) sprintf("\\textbf{[deposit %s missing]}", gsub("_", "\\\\_", what))   # the marker for an absent deposit
latex_table <- function(df, digits = 0, align = NULL) {
  # a plain booktabs tabular; numeric columns rounded and comma-separated
  is_num <- vapply(df, is.numeric, TRUE)
  body <- df
  for (j in which(is_num)) body[[j]] <- ifelse(is.na(df[[j]]), "", fmt(df[[j]], digits))
  if (is.null(align)) align <- paste0("l", strrep("r", ncol(df) - 1L))
  cat("\\begin{tabular}{", align, "}\n\\toprule\n", sep = "")
  cat(paste(gsub("_", "\\\\_", names(df)), collapse = " & "), "\\\\\n\\midrule\n")
  for (i in seq_len(nrow(df))) cat(paste(as.character(unlist(body[i, ])), collapse = " & "), "\\\\\n")
  cat("\\bottomrule\n\\end{tabular}\n")
}
latex_table_grouped <- function(df, groups, sub, digits = 0, align = NULL, first = names(df)[1], lead = 1L) {
  # header row 1: group labels spanning columns; row 2: the sub-labels; `lead` leading columns unspanned
  is_num <- vapply(df, is.numeric, TRUE); body <- df
  for (j in which(is_num)) body[[j]] <- ifelse(is.na(df[[j]]), "", fmt(df[[j]], digits))
  if (is.null(align)) align <- paste0("l", strrep("r", ncol(df) - 1L))
  cat("\\begin{tabular}{", align, "}\n\\toprule\n", sep = "")
  spans <- vapply(groups, function(g) g$span, 1L); starts <- cumsum(c(lead + 1L, spans))[seq_along(spans)]
  cat(strrep(" & ", lead), paste(sprintf("\\multicolumn{%d}{c}{%s}", spans, vapply(groups, function(g) g$label, "")), collapse = " & "), " \\\\\n", sep = "")
  cat(paste(sprintf("\\cmidrule(lr){%d-%d}", starts, starts + spans - 1L), collapse = ""), "\n", sep = "")
  cat(first, " & ", paste(sub, collapse = " & "), " \\\\\n\\midrule\n", sep = "")
  for (i in seq_len(nrow(df))) cat(paste(as.character(unlist(body[i, ])), collapse = " & "), "\\\\\n")
  cat("\\bottomrule\n\\end{tabular}\n")
}
