%% -- Article metainformation (author, title, ...) -----------------------------
\author{Jan Janou\v{s}ek~\orcidlink{0009-0007-3731-4416}\\Charles University
   \And Michal Pe\v{s}ta~\orcidlink{0000-0001-5311-0797}\\Charles University}
\Plainauthor{Jan Janou\v{s}ek, Michal Pe\v{s}ta}

\title{\pkg{baggingReserve}: Bagging and Regression Trees for Individual Claims Reserving in \proglang{R}}
\Plaintitle{baggingReserve: Bagging and Regression Trees for Individual Claims Reserving in R}
\Shorttitle{\pkg{baggingReserve}: Individual Claims Reserving in \proglang{R}}

\Abstract{
  The \proglang{R} package \pkg{baggingReserve} provides three things for claim-level loss
  reserving: a data contract that turns a table of claims and a table of payment transactions
  into a claim-by-development-year panel at a valuation date; a recursion engine that completes
  the payment history of every reported claim with one regression per development year, through
  an interface for user-supplied learners and with plugged-in or simulated completion; and
  back-tests that score a prediction, by calendar year and separately for reported claims and
  claims incurred but not reported (IBNR), against realised payments and a reference method
  such as the chain ladder. The default baseline is the method of \citet{Janousek+Pesta:2025}:
  regression trees with bagging, whose replicates describe resampling variation, not a
  predictive distribution, and chain-ladder projections of the IBNR claim counts. On a shipped
  synthetic portfolio, further portfolios from the same generator and an illustrative motor
  third-party liability dataset, the standard chain ladder is more accurate than the bagged
  trees on most portfolios. A correctly specified simulation shows that the default plug-in
  completion is biased for multi-year totals when whether a claim pays depends on its payment
  history; simulated completion removes most of that bias. Only static claim features are
  supported. The package makes such checks routine, so that claim-level methods can be tested
  on a user's own data before they are relied upon.
}

\Keywords{claim-level reserving, back-testing, bagging, regression trees, chain ladder, \proglang{R}}
\Plainkeywords{claim-level reserving, back-testing, bagging, regression trees, chain ladder, R}

\Address{
  Jan Janou\v{s}ek, Michal Pe\v{s}ta\\
  Department of Probability and Mathematical Statistics\\
  Faculty of Mathematics and Physics\\
  Charles University\\
  Sokolovsk\'a 49/83, 186 00 Prague, Czech Republic\\
